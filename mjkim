 {k:'fb',e:'🍎',n:'사과',s:'1개 200g',kcal:105,p:0.5,f:0.3,c:28,fb:4.8,w:'껍질째 먹어야 섬유질이 살아있어요'},
 {k:'fb',e:'🍅',n:'방울토마토',s:'100g',kcal:18,p:0.9,f:0.2,c:4,fb:1.2,w:'입 심심할 때 집어먹기. 칼로리가 거의 안 붙음'},
 {k:'fb',e:'🍙',n:'조미김',s:'1봉 4g',kcal:15,p:1.6,f:0.6,c:1.5,fb:1.4,w:'밥 없이도 섬유질. 가볍고 어디서든 삼'},
 {k:'fb',e:'🥗',n:'샐러드 팩',s:'1개 150g',kcal:35,p:2,f:0.3,c:7,fb:3,w:'씻고 자르기 싫은 날의 정답. 드레싱만 조심'},
 {k:'cvs',e:'🥤',n:'프로틴 음료',s:'250ml 1병',kcal:130,p:20,f:2,c:8,fb:0,w:'뚜껑 열고 원샷. 단백질 20g을 3초 만에 넣는 방법'},
 {k:'cvs',e:'🥗',n:'닭가슴살 샐러드(냉장)',s:'1팩',kcal:180,p:20,f:6,c:10,fb:3,w:'단백질이랑 채소를 한 번에. 냉장 코너 스테디셀러'},
 {k:'cvs',e:'🥚',n:'훈제란',s:'2입',kcal:150,p:13,f:10,c:1,fb:0,w:'까져 있어서 손도 안 더러워짐. 껍질 까기 귀찮은 날의 계란'},
 {k:'cvs',e:'🍙',n:'삼각김밥(참치마요)',s:'1개',kcal:200,p:5,f:5,c:33,fb:1,w:'탄수 급할 때. 단백질은 별로라 계란이랑 같이 드세요'},
 {k:'cvs',e:'🍠',n:'군고구마(편의점)',s:'1개 150g',kcal:130,p:2,f:0.2,c:31,fb:3.5,w:'따뜻하고 달고 배부름. 겨울엔 이거 하나로 버팀'},
 {k:'cvs',e:'🥛',n:'무첨가 두유',s:'190ml',kcal:90,p:6,f:4,c:7,fb:1,w:'상온 보관에 유당 걱정 없음. 무설탕 라인으로'},
 {k:'cvs',e:'🍍',n:'컵과일',s:'1컵 150g',kcal:70,p:0.6,f:0.2,c:17,fb:2,w:'과일 사서 썰기 싫을 때. 단맛 욕구 잠재우기용'},
 {k:'cvs',e:'🍫',n:'프로틴바',s:'1개',kcal:200,p:12,f:8,c:20,fb:2,w:'과자 살 뻔한 순간의 대타. 당류 표시는 꼭 보기'},
 {k:'cvs',e:'🍡',n:'곤약젤리',s:'1개',kcal:25,p:0,f:0,c:6,fb:1.5,w:'입 심심할 때 칼로리 거의 안 붙이고 씹는 맛만'},
 {k:'cvs',e:'🍢',n:'어묵바',s:'1개 80g',kcal:110,p:8,f:3,c:12,fb:0,w:'따뜻한 게 땡길 때. 국물은 나트륨이라 조금만'}
];

const COMBOS=[
 {n:'아침 3분 세트',i:{'프로틴 음료':1,'바나나':1,'삶은 계란':1},w:'씻을 것도 데울 것도 없음'},
 {n:'점심 때우기 세트',i:{'닭가슴살 샐러드(냉장)':1,'삼각김밥(참치마요)':1,'무첨가 두유':1},w:'한 끼 구색이 다 맞음'},
 {n:'야근 버티기 세트',i:{'훈제란':1,'컵과일':1,'아몬드':1},w:'배는 채우고 칼로리는 덜'},
 {n:'운동 직후 세트',i:{'프로틴 음료':1,'군고구마(편의점)':1},w:'단백질 + 빠른 탄수 조합'},
 {n:'과자 대신 세트',i:{'곤약젤리':1,'프로틴바':1},w:'단 거 땡길 때 방어용'}
];

const T={p:0,f:0,c:0,fb:0,k:0};
let tab='cvs', picks={};

const $=id=>document.getElementById(id);
const cm=n=>Math.round(n).toLocaleString('ko-KR');

function calc(){
  const w=Math.min(150,Math.max(30,parseFloat($('wNum').value)||70));
  T.k=w*23; T.p=w*2.2; T.f=w*0.7;
  const rest=T.k-(T.p*4)-(T.f*9);
  T.c=Math.max(0,rest/4);
  T.fb=T.k/1000*14;

  $('kcal').textContent=cm(T.k);
  $('kf').textContent=(+w.toFixed(1))+' × 23';
  $('pG').textContent=T.p.toFixed(0)+'g'; $('pS').textContent='체중 × 2.2 · '+cm(T.p*4)+'kcal';
  $('fG').textContent=T.f.toFixed(0)+'g'; $('fS').textContent='체중 × 0.7 · '+cm(T.f*9)+'kcal';
  $('cG').textContent=T.c.toFixed(0)+'g'; $('cS').textContent='남은 칼로리 ÷ 4 · '+cm(T.c*4)+'kcal';
  $('bG').textContent=T.fb.toFixed(0)+'g'; $('bS').textContent='칼로리 ÷ 1000 × 14';

  const kp=T.p*4,kf=T.f*9,kc=T.c*4,tot=kp+kf+kc||1;
  const rp=kp/tot*100,rf=kf/tot*100,rc=kc/tot*100;
  $('slotP').style.flexGrow=rp; $('slotF').style.flexGrow=rf; $('slotC').style.flexGrow=rc;
  $('pctP').textContent=Math.round(rp)+'%'; $('pctF').textContent=Math.round(rf)+'%'; $('pctC').textContent=Math.round(rc)+'%';
  $('kP').textContent=cm(kp)+'kcal'; $('kF').textContent=cm(kf)+'kcal'; $('kC').textContent=cm(kc)+'kcal';
  $('fbSide').textContent=T.fb.toFixed(0)+'g';
  tally();
}

function setW(v,from){
  v=Math.min(150,Math.max(30,v));
  $('wNum').value=+v.toFixed(1);
  if(from!=='range') $('wRange').value=Math.min(120,Math.max(35,v));
  calc();
}
$('wNum').addEventListener('input',()=>{const v=parseFloat($('wNum').value); if(!isNaN(v)) setW(v);});
$('wRange').addEventListener('input',e=>setW(parseFloat(e.target.value),'range'));
$('plus').onclick=()=>setW((parseFloat($('wNum').value)||70)+1);
$('minus').onclick=()=>setW((parseFloat($('wNum').value)||70)-1);

function render(){
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.k===tab));

  let head='';
  if(tab==='cvs'){
    head='<div class="combo-title">⚡ 고민하기 싫으면 세트로 (눌러서 한 번에 담기)</div><div class="combos">'+
      COMBOS.map((cb,ci)=>{
        let k=0,pp=0,items=[];
        for(const n in cb.i){const f=FOODS.find(x=>x.n===n);if(!f)continue;
          k+=f.kcal*cb.i[n]; pp+=f.p*cb.i[n]; items.push(f.e+' '+f.n.replace(/\(.*\)/,''));}
        return `<div class="combo" data-ci="${ci}">
          <div class="cn">${cb.n}</div>
          <div class="ci">${items.join('<br>')}</div>
          <div class="ci" style="margin-top:5px;opacity:.6">${cb.w}</div>
          <div class="ck">${Math.round(k)}kcal · 단백질 ${Math.round(pp)}g</div>
        </div>`;
      }).join('')+'</div>';
  }

  $('foods').innerHTML=head+FOODS.filter(f=>f.k===tab).map((f,i)=>{
    const id=f.n, c=picks[id]||0;
    return `<div class="food ${c?'picked':''}" data-n="${id}">
      <div class="emo">${f.e}</div>
      <div class="fbody">
        <div class="fname">${f.n}<span class="serv">${f.s}</span></div>
        <div class="why">${f.w}</div>
        <div class="nums">${f.kcal}kcal · 단 ${f.p}g · 지 ${f.f}g · 탄 ${f.c}g · 섬유 ${f.fb}g</div>
      </div>
      <div class="cnt ${c?'':'zero'}">${c?'×'+c:'+'}</div>
    </div>`;
  }).join('');
  document.querySelectorAll('.food').forEach(el=>{
    let timer=null,longp=false;
    const n=el.dataset.n;
    const add=()=>{picks[n]=(picks[n]||0)+1;render();tally();};
    const sub=()=>{picks[n]=Math.max(0,(picks[n]||0)-1);if(!picks[n])delete picks[n];render();tally();};
    el.addEventListener('pointerdown',()=>{longp=false;timer=setTimeout(()=>{longp=true;sub();},450);});
    el.addEventListener('pointerup',()=>{clearTimeout(timer);if(!longp)add();});
    el.addEventListener('pointerleave',()=>clearTimeout(timer));
    el.addEventListener('contextmenu',e=>e.preventDefault());
  });
  document.querySelectorAll('.combo').forEach(el=>{
    el.onclick=()=>{
      const cb=COMBOS[+el.dataset.ci];
      for(const n in cb.i) picks[n]=(picks[n]||0)+cb.i[n];
      render(); tally();
    };
  });
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{tab=t.dataset.k;render();});

function tally(){
  const s={kcal:0,p:0,f:0,c:0,fb:0};
  for(const n in picks){const f=FOODS.find(x=>x.n===n);if(!f)continue;
    s.kcal+=f.kcal*picks[n];s.p+=f.p*picks[n];s.f+=f.f*picks[n];s.c+=f.c*picks[n];s.fb+=f.fb*picks[n];}
  const set=(bar,txt,cur,goal,unit)=>{
    const pct=goal?Math.min(100,cur/goal*100):0;
    $(bar).style.width=pct+'%';
    const t=$(txt); t.textContent=cm(cur)+(unit||'')+' / '+cm(goal)+(unit||'');
    t.classList.toggle('over',cur>goal*1.05);
  };
  set('bK','tK',s.kcal,T.k,''); set('bP','tP',s.p,T.p,'g');
  set('bF','tF',s.f,T.f,'g'); set('bC','tC',s.c,T.c,'g'); set('bB','tB',s.fb,T.fb,'g');
}
$('reset').onclick=()=>{picks={};render();tally();};

render(); calc();
</script>
</body>
</html>
