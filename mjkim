<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>몸무게만 넣어 · 매크로 계산기</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&display=swap" rel="stylesheet">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
<style>
:root{
  --ink:#1A1526;
  --bg:#EDE7FF;
  --paper:#FFFDF5;
  --coral:#FF6B85;
  --butter:#FFD84D;
  --grape:#7A6CFF;
  --mint:#5FDDB8;
  --peach:#FFA46B;
  --shadow:4px 4px 0 var(--ink);
  --shadow-sm:3px 3px 0 var(--ink);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{
  font-family:'Pretendard Variable',Pretendard,-apple-system,BlinkMacSystemFont,system-ui,'Apple SD Gothic Neo',sans-serif;
  background:var(--bg);
  background-image:radial-gradient(var(--ink) 1px, transparent 1.2px);
  background-size:22px 22px;
  color:var(--ink);
  line-height:1.5;
  padding:18px 14px 70px;
}
.wrap{max-width:560px;margin:0 auto}
.display{font-family:'Bagel Fat One',cursive;font-weight:400;letter-spacing:-0.01em}

/* header */
.hero{
  background:var(--butter);border:2.5px solid var(--ink);border-radius:20px;
  box-shadow:var(--shadow);padding:20px 18px;margin-bottom:16px;position:relative;overflow:hidden;
}
.eyebrow{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;opacity:.6}
.hero h1{font-size:clamp(25px,7.6vw,36px);line-height:1.18;margin:6px 0 8px}
.hero p{font-size:13px;font-weight:600;opacity:.72}
.blob{position:absolute;right:-26px;top:-26px;width:110px;height:110px;background:var(--coral);border:2.5px solid var(--ink);border-radius:50%;z-index:0;opacity:.9}
.hero>*{position:relative;z-index:1}

.card{background:var(--paper);border:2.5px solid var(--ink);border-radius:20px;box-shadow:var(--shadow);padding:18px 16px;margin-bottom:16px}
.sec-title{font-size:16px;font-weight:900;display:flex;align-items:center;gap:7px;margin-bottom:4px}
.sec-sub{font-size:12px;font-weight:600;opacity:.6;margin-bottom:14px}

/* weight */
.wrow{display:flex;align-items:center;justify-content:center;gap:14px;margin:4px 0 12px}
.step{width:46px;height:46px;flex:0 0 46px;border:2.5px solid var(--ink);border-radius:14px;background:var(--mint);
  font-size:24px;font-weight:900;line-height:1;cursor:pointer;box-shadow:var(--shadow-sm);transition:transform .08s,box-shadow .08s}
.step:active{transform:translate(3px,3px);box-shadow:none}
.wbox{display:flex;align-items:baseline;gap:4px}
#wNum{font-family:'Bagel Fat One',cursive;font-size:52px;width:120px;text-align:center;border:none;background:transparent;color:var(--ink);outline:none}
.kg{font-size:19px;font-weight:900;opacity:.55}
input[type=range]{-webkit-appearance:none;width:100%;height:14px;border:2.5px solid var(--ink);border-radius:99px;background:linear-gradient(90deg,var(--coral) 0%,var(--butter) 55%,var(--mint) 100%);outline:none}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;border-radius:50%;background:var(--paper);border:2.5px solid var(--ink);box-shadow:2px 2px 0 var(--ink);cursor:pointer}
input[type=range]::-moz-range-thumb{width:30px;height:30px;border-radius:50%;background:var(--paper);border:2.5px solid var(--ink);cursor:pointer}
.rlabel{display:flex;justify-content:space-between;font-size:11px;font-weight:800;opacity:.45;margin-top:6px}

/* kcal banner */
.kcal{background:var(--ink);color:var(--paper);border-radius:16px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;margin:16px 0 12px}
.kcal .lab{font-size:11.5px;font-weight:800;letter-spacing:.1em;opacity:.65}
.kcal .val{font-family:'Bagel Fat One',cursive;font-size:34px;line-height:1}
.kcal .formula{font-size:11px;font-weight:700;opacity:.5;text-align:right}

/* macro grid */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.m{border:2.5px solid var(--ink);border-radius:16px;padding:11px 12px;box-shadow:var(--shadow-sm)}
.m .n{font-size:12px;font-weight:900;display:flex;align-items:center;gap:5px}
.m .g{font-family:'Bagel Fat One',cursive;font-size:29px;line-height:1.15}
.m .sub{font-size:10.5px;font-weight:700;opacity:.6}
.m.p{background:var(--coral)}
.m.f{background:var(--butter)}
.m.c{background:var(--grape);color:var(--paper)}
.m.fb{background:var(--mint)}

/* tray */
.tray{border:2.5px solid var(--ink);border-radius:18px;background:#fff;padding:9px;display:flex;gap:8px;height:132px}
.slot{border:2.5px solid var(--ink);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;transition:flex-grow .45s cubic-bezier(.34,1.4,.5,1);text-align:center;padding:4px}
.slot .sn{font-size:11px;font-weight:900;white-space:nowrap}
.slot .sp{font-family:'Bagel Fat One',cursive;font-size:19px;line-height:1.2}
.slot .sg{font-size:10px;font-weight:800;opacity:.65;white-space:nowrap}
.side{margin-top:9px;border:2.5px solid var(--ink);border-radius:12px;background:var(--mint);padding:7px 12px;display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:900}

/* foods */
.tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.tab{border:2.5px solid var(--ink);border-radius:99px;background:#fff;padding:6px 12px;font-size:12px;font-weight:900;cursor:pointer;font-family:inherit;color:var(--ink)}
.tab.on{box-shadow:var(--shadow-sm)}
.tab[data-k=p].on{background:var(--coral)}
.tab[data-k=f].on{background:var(--butter)}
.tab[data-k=c].on{background:var(--grape);color:#fff}
.tab[data-k=fb].on{background:var(--mint)}
.tab[data-k=cvs].on{background:var(--peach)}
.combos{display:flex;gap:9px;overflow-x:auto;padding:2px 2px 10px;margin-bottom:4px;scrollbar-width:none}
.combos::-webkit-scrollbar{display:none}
.combo{flex:0 0 190px;border:2.5px solid var(--ink);border-radius:14px;background:var(--peach);padding:10px 11px;cursor:pointer;box-shadow:var(--shadow-sm);transition:transform .08s,box-shadow .08s}
.combo:active{transform:translate(3px,3px);box-shadow:none}
.combo .cn{font-size:13px;font-weight:900;margin-bottom:3px}
.combo .ci{font-size:11px;font-weight:700;opacity:.75;line-height:1.45}
.combo .ck{font-size:10.5px;font-weight:900;margin-top:6px;background:var(--ink);color:var(--paper);display:inline-block;padding:2px 7px;border-radius:99px}
.combo-title{font-size:12px;font-weight:900;opacity:.6;margin-bottom:7px}
.foods{display:flex;flex-direction:column;gap:9px}
.food{border:2.5px solid var(--ink);border-radius:14px;background:#fff;padding:10px 11px;display:flex;gap:10px;align-items:flex-start;cursor:pointer;transition:transform .08s,box-shadow .08s}
.food:active{transform:translate(2px,2px)}
.food.picked{box-shadow:var(--shadow-sm)}
.emo{font-size:23px;line-height:1.2}
.fbody{flex:1;min-width:0}
.fname{font-size:13.5px;font-weight:900;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.serv{font-size:10.5px;font-weight:800;opacity:.5}
.why{font-size:11.5px;font-weight:600;opacity:.72;margin-top:2px}
.nums{font-size:10.5px;font-weight:800;opacity:.55;margin-top:4px}
.cnt{min-width:26px;height:26px;border:2.5px solid var(--ink);border-radius:9px;background:var(--butter);font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0 5px}
.cnt.zero{background:#fff;opacity:.35}

/* tally */
.bar-row{margin-bottom:11px}
.bar-top{display:flex;justify-content:space-between;font-size:11.5px;font-weight:900;margin-bottom:4px}
.bar{height:16px;border:2.5px solid var(--ink);border-radius:99px;background:#fff;overflow:hidden}
.fill{height:100%;width:0;transition:width .4s cubic-bezier(.34,1.3,.5,1)}
.fill.p{background:var(--coral)}.fill.f{background:var(--butter)}.fill.c{background:var(--grape)}.fill.fb{background:var(--mint)}.fill.k{background:var(--ink)}
.over{color:var(--coral)}
.reset{width:100%;border:2.5px solid var(--ink);border-radius:12px;background:#fff;padding:9px;font-size:12.5px;font-weight:900;cursor:pointer;font-family:inherit;color:var(--ink);margin-top:4px}
.note{font-size:11px;font-weight:600;line-height:1.65;opacity:.6}
.note b{opacity:.9}
@media (max-width:380px){.grid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">

  <div class="hero">
    <div class="blob"></div>
    <div class="eyebrow">몸무게 하나로 끝</div>
    <h1 class="display">오늘 뭘<br>얼마나 먹지?</h1>
    <p>숫자 넣으면 단백질·지방·탄수·식이섬유까지 자동으로 나와요 🍙</p>
  </div>

  <!-- 몸무게 -->
  <div class="card">
    <div class="sec-title">⚖️ 내 몸무게</div>
    <div class="sec-sub">버튼이나 슬라이더로 조절하면 아래가 전부 바뀌어요</div>
    <div class="wrow">
      <button class="step" id="minus" aria-label="1kg 빼기">−</button>
      <div class="wbox"><input id="wNum" type="number" value="70" min="30" max="150" inputmode="decimal"><span class="kg">kg</span></div>
      <button class="step" id="plus" aria-label="1kg 더하기">+</button>
    </div>
    <input type="range" id="wRange" min="35" max="120" step="1" value="70">
    <div class="rlabel"><span>35kg</span><span>120kg</span></div>

    <div class="kcal">
      <div><div class="lab">하루 총 칼로리</div><div class="val" id="kcal">1,610</div></div>
      <div class="formula" id="kf">70 × 23</div>
    </div>

    <div class="grid">
      <div class="m p"><div class="n">🍗 단백질</div><div class="g" id="pG">154g</div><div class="sub" id="pS">체중 × 2.2 · 616kcal</div></div>
      <div class="m f"><div class="n">🥑 지방</div><div class="g" id="fG">49g</div><div class="sub" id="fS">체중 × 0.7 · 441kcal</div></div>
      <div class="m c"><div class="n">🍠 탄수화물</div><div class="g" id="cG">138g</div><div class="sub" id="cS">남은 칼로리 ÷ 4</div></div>
      <div class="m fb"><div class="n">🥦 식이섬유</div><div class="g" id="bG">23g</div><div class="sub" id="bS">칼로리 ÷ 1000 × 14</div></div>
    </div>
  </div>

  <!-- 도시락 트레이 -->
  <div class="card">
    <div class="sec-title">🍱 하루치를 도시락으로 보면</div>
    <div class="sec-sub">칸 크기 = 그 영양소가 차지하는 칼로리 비중</div>
    <div class="tray">
      <div class="slot" id="slotP" style="background:var(--coral);flex-grow:38">
        <div class="sn">단백질</div><div class="sp display" id="pctP">38%</div><div class="sg" id="kP">616kcal</div>
      </div>
      <div class="slot" id="slotF" style="background:var(--butter);flex-grow:27">
        <div class="sn">지방</div><div class="sp display" id="pctF">27%</div><div class="sg" id="kF">441kcal</div>
      </div>
      <div class="slot" id="slotC" style="background:var(--grape);color:#FFFDF5;flex-grow:34">
        <div class="sn">탄수</div><div class="sp display" id="pctC">34%</div><div class="sg" id="kC">553kcal</div>
      </div>
    </div>
    <div class="side"><span>🥦 여기에 식이섬유 <span id="fbSide">23g</span> 따로 챙기기</span><span style="opacity:.55">칼로리 거의 0</span></div>
  </div>

  <!-- 음식 -->
  <div class="card">
    <div class="sec-title">🛒 어디서든 살 수 있는 것들</div>
    <div class="sec-sub">눌러서 담으면 아래 게이지가 채워져요 (한 번 더 누르면 +1, 길게 누르면 빼기)</div>
    <div class="tabs">
      <button class="tab on" data-k="cvs">🏪 편의점</button>
      <button class="tab" data-k="p">🍗 단백질</button>
      <button class="tab" data-k="f">🥑 지방</button>
      <button class="tab" data-k="c">🍠 탄수</button>
      <button class="tab" data-k="fb">🥦 식이섬유</button>
    </div>
    <div class="foods" id="foods"></div>
  </div>

  <!-- 오늘 담은 거 -->
  <div class="card">
    <div class="sec-title">📊 오늘 담은 거</div>
    <div class="sec-sub">목표 대비 얼마나 찼는지</div>
    <div class="bar-row"><div class="bar-top"><span>🔥 칼로리</span><span id="tK">0 / 1,610</span></div><div class="bar"><div class="fill k" id="bK"></div></div></div>
    <div class="bar-row"><div class="bar-top"><span>🍗 단백질</span><span id="tP">0 / 154g</span></div><div class="bar"><div class="fill p" id="bP"></div></div></div>
    <div class="bar-row"><div class="bar-top"><span>🥑 지방</span><span id="tF">0 / 49g</span></div><div class="bar"><div class="fill f" id="bF"></div></div></div>
    <div class="bar-row"><div class="bar-top"><span>🍠 탄수</span><span id="tC">0 / 138g</span></div><div class="bar"><div class="fill c" id="bC"></div></div></div>
    <div class="bar-row"><div class="bar-top"><span>🥦 식이섬유</span><span id="tB">0 / 23g</span></div><div class="bar"><div class="fill fb" id="bB"></div></div></div>
    <button class="reset" id="reset">🧹 싹 비우기</button>
  </div>

  <div class="card" style="box-shadow:none;background:transparent;border-style:dashed">
    <div class="note">
      <b>계산식</b> — 총칼로리 = 체중×23 / 단백질 = 체중×2.2g / 지방 = 체중×0.7g / 탄수 = (총칼로리 − 단백질kcal − 지방kcal) ÷ 4 / 식이섬유 = 총칼로리÷1000×14. 원본 영상에 적힌 공식 그대로예요.<br><br>
      <b>주의</b> — 음식 영양수치는 제품·조리법마다 달라서 <b>대략치</b>입니다. 정확한 값은 제품 뒷면 표시를 확인하세요. 그리고 이 공식은 트레이너 한 명의 기준이라 모두에게 맞는 건 아니에요.
    </div>
  </div>
</div>

<script>
// 영양수치는 100g/1회 제공량 기준 대략치
const FOODS=[
 {k:'p',e:'🐔',n:'닭가슴살',s:'100g',kcal:105,p:23,f:1.2,c:0,fb:0,w:'단백질 깡패. 편의점에도 마트에도 무조건 있음'},
