.pdf-rendering .toolbar, .pdf-rendering .mode-banner,
.pdf-rendering .widget-controls, .pdf-rendering .drag-handle,
.pdf-rendering .hidden-tray { display:none !important; }
.pdf-rendering .widget { border:1px solid #E5E7EB !important; background:#fff !important; }
</style>
