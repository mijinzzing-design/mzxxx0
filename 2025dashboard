initCharts();

// ============ EDIT MODE ============
const grid = document.getElementById('grid');
const editBtn = document.getElementById('editBtn');
const resetBtn = document.getElementById('resetBtn');
const pdfBtn = document.getElementById('pdfBtn');
const hiddenTray = document.getElementById('hiddenTray');
const hiddenList = document.getElementById('hiddenList');

const WIDTH_OPTIONS = [3,4,6,8,9,12];
const WIDTH_LABEL = {3:'25%',4:'33%',6:'50%',8:'67%',9:'75%',12:'100%'};

// Build width picker buttons for each widget
document.querySelectorAll('.width-picker').forEach(picker => {
  const widget = picker.closest('.widget');
  WIDTH_OPTIONS.forEach(w => {
    const b = document.createElement('button');
    b.textContent = WIDTH_LABEL[w];
    b.dataset.w = w;
    b.addEventListener('click', e=>{
      e.stopPropagation();
      setWidth(widget, w);
      saveLayout();
    });
    picker.appendChild(b);
  });
  updateWidthPicker(widget);
});
document.querySelectorAll('.ctl-btn.hide').forEach(btn => {
  btn.addEventListener('click', e=>{
    e.stopPropagation();
    const w = btn.closest('.widget');
    w.classList.add('hidden');
    saveLayout();
    refreshHiddenTray();
  });
});

function setWidth(widget, w){
  WIDTH_OPTIONS.forEach(x => widget.classList.remove('w-'+x));
  widget.classList.add('w-'+w);
  widget.dataset.w = w;
  updateWidthPicker(widget);
  // Resize charts when their container size changes
  setTimeout(()=>{ if(chart1) chart1.resize(); if(chart2) chart2.resize(); if(chart3) chart3.resize(); }, 50);
}
function updateWidthPicker(widget){
  const cur = widget.dataset.w;
  widget.querySelectorAll('.width-picker button').forEach(b => {
    b.classList.toggle('active', b.dataset.w === cur);
  });
}

// Drag & drop reorder
let dragSrc = null;
function setupDragHandlers(widget){
  widget.addEventListener('dragstart', e => {
    if(!document.body.classList.contains('edit-mode')){ e.preventDefault(); return; }
    dragSrc = widget;
    widget.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });
  widget.addEventListener('dragend', () => {
    widget.classList.remove('dragging');
    document.querySelectorAll('.widget').forEach(w => w.classList.remove('drag-over'));
    saveLayout();
  });
  widget.addEventListener('dragover', e => {
    if(!document.body.classList.contains('edit-mode')) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if(widget !== dragSrc) widget.classList.add('drag-over');
  });
  widget.addEventListener('dragleave', () => widget.classList.remove('drag-over'));
  widget.addEventListener('drop', e => {
    e.preventDefault();
    widget.classList.remove('drag-over');
    if(dragSrc && dragSrc !== widget){
      const rect = widget.getBoundingClientRect();
      const after = (e.clientY - rect.top) > rect.height/2;
      widget.parentNode.insertBefore(dragSrc, after ? widget.nextSibling : widget);
    }
  });
}
document.querySelectorAll('.widget').forEach(setupDragHandlers);

// Edit mode toggle
editBtn.addEventListener('click', ()=>{
  document.body.classList.toggle('edit-mode');
  const on = document.body.classList.contains('edit-mode');
  editBtn.textContent = on ? '편집 모드 OFF' : '편집 모드 ON';
  editBtn.classList.toggle('active', on);
  hiddenTray.classList.toggle('active', on);
  refreshHiddenTray();
  setTimeout(()=>{ if(chart1) chart1.resize(); if(chart2) chart2.resize(); if(chart3) chart3.resize(); }, 50);
});

resetBtn.addEventListener('click', ()=>{
  if(!confirm('레이아웃을 초기 상태로 복구할까요?')) return;
  localStorage.removeItem('dashboard_layout_v1');
  location.reload();
});

function refreshHiddenTray(){
  hiddenList.innerHTML = '';
  const hidden = document.querySelectorAll('.widget.hidden');
  if(hidden.length === 0){
    hiddenList.innerHTML = '<div style="color:#9CA3AF;font-size:11px">없음</div>';
    return;
  }
  hidden.forEach(w => {
    const item = document.createElement('div');
    item.className = 'hidden-item';
    const name = w.querySelector('h2')?.textContent || w.querySelector('.kpi-label')?.textContent || w.dataset.id;
    item.innerHTML = `<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:6px">${name}</span><button>표시</button>`;
    item.querySelector('button').addEventListener('click', ()=>{
      w.classList.remove('hidden');
      saveLayout();
      refreshHiddenTray();
    });
    hiddenList.appendChild(item);
  });
}

// ============ LAYOUT SAVE/LOAD ============
const LS_KEY = 'dashboard_layout_v1';
function saveLayout(){
  const widgets = Array.from(document.querySelectorAll('.widget')).map(w => ({
    id: w.dataset.id, width: w.dataset.w, hidden: w.classList.contains('hidden')
  }));
  localStorage.setItem(LS_KEY, JSON.stringify(widgets));
}
function loadLayout(){
  const raw = localStorage.getItem(LS_KEY);
  if(!raw) return;
  try {
    const layout = JSON.parse(raw);
    // Reorder widgets according to saved layout
    layout.forEach(item => {
      const w = document.querySelector(`.widget[data-id="${item.id}"]`);
      if(!w) return;
      grid.appendChild(w);
      setWidth(w, parseInt(item.width));
      if(item.hidden) w.classList.add('hidden');
    });
  } catch(e){ console.error(e); }
}
loadLayout();
refreshHiddenTray();

// ============ PDF EXPORT ============
pdfBtn.addEventListener('click', async ()=>{
  pdfBtn.disabled = true;
  pdfBtn.textContent = 'PDF 생성 중...';
  const wasEdit = document.body.classList.contains('edit-mode');
  if(wasEdit){ editBtn.click(); }
  document.body.classList.add('pdf-rendering');
  await new Promise(r => setTimeout(r, 400));
  const element = document.getElementById('pdfPage');
  const opt = {
    margin: [10, 10, 10, 10],
    filename: '2025_상담통계_대시보드.pdf',
    image: { type: 'jpeg', quality: 0.95 },
    html2canvas: { scale: 2, useCORS: true, backgroundColor:'#ffffff' },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
    pagebreak: { mode: ['css', 'legacy'], avoid: '.widget' }
  };
  try {
    await html2pdf().set(opt).from(element).save();
  } catch(e){
    alert('PDF 생성 중 오류: ' + e.message);
  } finally {
    document.body.classList.remove('pdf-rendering');
    pdfBtn.disabled = false;
    pdfBtn.textContent = 'PDF 다운로드';
    if(wasEdit){ editBtn.click(); }
  }
});
</script>
