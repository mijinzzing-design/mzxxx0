<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Malgun Gothic','맑은 고딕',sans-serif; background:#F4F6FA; color:#1F2937; }

/* ========== Toolbar ========== */
.toolbar { position:sticky; top:0; z-index:100; background:#1F4E78; color:#fff; padding:10px 20px;
  display:flex; gap:10px; align-items:center; flex-wrap:wrap; box-shadow:0 2px 6px rgba(0,0,0,.15); }
.toolbar h1 { font-size:16px; flex-grow:1; }
.btn { background:#2563EB; color:#fff; border:none; padding:8px 14px; border-radius:6px; cursor:pointer;
  font-size:13px; font-weight:600; transition:.15s; }
.btn:hover { background:#1D4ED8; }
.btn.edit { background:#16A34A; }
.btn.edit:hover { background:#15803D; }
.btn.edit.active { background:#DC2626; }
.btn.edit.active:hover { background:#B91C1C; }
.btn.pdf { background:#F59E0B; }
.btn.pdf:hover { background:#D97706; }
.btn.reset { background:#6B7280; }
.btn.reset:hover { background:#4B5563; }
.btn:disabled { opacity:.5; cursor:not-allowed; }

.mode-banner { background:#FEF3C7; color:#92400E; padding:10px 20px; font-size:13px; font-weight:600;
  display:none; border-bottom:1px solid #F59E0B; }
body.edit-mode .mode-banner { display:block; }

/* ========== Page (PDF target) ========== */
.pdf-page { background:#fff; margin:24px auto; padding:30px 30px 20px; max-width:1180px;
  box-shadow:0 2px 8px rgba(0,0,0,.05); border-radius:8px; }
.pdf-title { color:#1F4E78; font-size:26px; font-weight:700; margin-bottom:4px; }
.pdf-sub { color:#6B7280; font-size:12px; margin-bottom:22px; }

/* ========== Grid ========== */
.grid { display:grid; grid-template-columns:repeat(12,1fr); gap:14px; }

.widget { background:#fff; border-radius:8px; padding:16px; border:1px solid #E5E7EB;
  position:relative; transition:.15s; min-height:80px; }
.widget h2 { color:#1F4E78; font-size:15px; margin-bottom:10px; padding-bottom:8px; border-bottom:2px solid #E5E7EB; }

/* Default widget sizes */
.widget.w-12 { grid-column:span 12; }
.widget.w-9 { grid-column:span 9; }
.widget.w-8 { grid-column:span 8; }
.widget.w-6 { grid-column:span 6; }
.widget.w-4 { grid-column:span 4; }
.widget.w-3 { grid-column:span 3; }
.widget.hidden { display:none !important; }

/* ========== Edit mode visual ========== */
body.edit-mode .widget { border:2px dashed #2563EB; cursor:move; background:#FAFBFF; }
body.edit-mode .widget:hover { border-color:#16A34A; background:#F0FDF4; }
body.edit-mode .widget.dragging { opacity:.4; }
body.edit-mode .widget.drag-over { border-color:#DC2626; border-style:solid; }

.widget-controls { display:none; position:absolute; top:6px; right:6px; gap:4px; z-index:5; }
body.edit-mode .widget-controls { display:flex; }
.ctl-btn { background:#1F4E78; color:#fff; border:none; width:26px; height:26px; border-radius:4px;
  font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; }
.ctl-btn:hover { background:#1E3A5F; }
.ctl-btn.hide { background:#6B7280; }
.ctl-btn.del { background:#DC2626; }

.width-picker { display:flex; gap:2px; background:rgba(0,0,0,.06); padding:2px; border-radius:4px; }
.width-picker button { background:transparent; color:#1F4E78; border:none; width:30px; height:22px;
  font-size:10px; font-weight:700; cursor:pointer; border-radius:3px; }
.width-picker button.active { background:#1F4E78; color:#fff; }

.drag-handle { position:absolute; left:6px; top:6px; background:#1F4E78; color:#fff;
  width:24px; height:24px; border-radius:4px; display:none; align-items:center; justify-content:center;
  font-size:14px; cursor:grab; }
body.edit-mode .drag-handle { display:flex; }
.drag-handle:active { cursor:grabbing; }

/* Hidden widgets list */
.hidden-tray { display:none; position:fixed; right:20px; bottom:20px; background:#fff;
  padding:12px; border-radius:8px; box-shadow:0 4px 12px rgba(0,0,0,.15); border:1px solid #E5E7EB;
  z-index:50; max-width:260px; }
body.edit-mode .hidden-tray.active { display:block; }
.hidden-tray h3 { font-size:12px; color:#6B7280; margin-bottom:8px; }
.hidden-item { display:flex; justify-content:space-between; align-items:center; padding:6px 0;
  border-bottom:1px dashed #E5E7EB; font-size:12px; }
.hidden-item button { background:#16A34A; color:#fff; border:none; padding:3px 8px; border-radius:3px;
  font-size:10px; cursor:pointer; }

/* ========== KPI cards ========== */
.kpi-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
.kpi { background:#fff; padding:14px; border-radius:8px; border-left:4px solid #1F4E78; border:1px solid #E5E7EB; border-left:4px solid #1F4E78; }
.kpi.success { border-left-color:#16A34A; }
.kpi.warning { border-left-color:#F59E0B; }
.kpi-label { font-size:11px; color:#6B7280; margin-bottom:4px; }
.kpi-value { font-size:18px; font-weight:700; color:#111827; }
.kpi-change { font-size:11px; margin-top:3px; color:#16A34A; font-weight:600; }

/* ========== Conclusion ========== */
.conclusion-box { background:linear-gradient(135deg,#DBEAFE 0%,#DCFCE7 100%); padding:18px;
  border-radius:8px; border-left:5px solid #16A34A; }
.conclusion-box h2 { color:#166534; margin-bottom:8px; font-size:15px; padding:0; border:none; }
.conclusion-box p { line-height:1.7; color:#374151; font-size:13px; }

/* ========== Charts ========== */
.chart-container { position:relative; height:280px; }
.chart-tall { height:340px; }

/* ========== Tables ========== */
table { width:100%; border-collapse:collapse; font-size:12px; }
th { background:#1F4E78; color:#fff; padding:8px; text-align:left; font-weight:600; }
td { padding:6px 8px; border-bottom:1px solid #E5E7EB; }
td.num { text-align:right; }
tr.before td:first-child { border-left:4px solid #F59E0B; }
tr.after td:first-child { border-left:4px solid #2563EB; }
tr.highlight { background:#FEF3C7; font-weight:600; }
.tag { display:inline-block; padding:2px 7px; border-radius:3px; font-size:10px; font-weight:600; }
.tag.before { background:#FED7AA; color:#9A3412; }
.tag.after { background:#BFDBFE; color:#1E40AF; }

/* ========== Top5 cards ========== */
.top5-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.month-card { background:#F9FAFB; padding:10px; border-radius:6px; border:1px solid #E5E7EB; font-size:11px; }
.month-card.after-policy { background:#EFF6FF; border-color:#BFDBFE; }
.month-card h3 { color:#1F4E78; font-size:12px; margin:0 0 6px; padding:0; border:none;
  display:flex; justify-content:space-between; align-items:center; }
.month-card .badge { font-size:9px; padding:2px 5px; border-radius:3px; }
.month-card ol { list-style:none; padding:0; counter-reset:rank; }
.month-card li { counter-increment:rank; padding:3px 0; border-bottom:1px dashed #E5E7EB;
  display:flex; justify-content:space-between; font-size:10px; }
.month-card li::before { content:counter(rank); display:inline-block; width:14px; height:14px; line-height:14px;
  text-align:center; background:#1F4E78; color:#fff; border-radius:50%; font-size:8px; margin-right:4px; }
.month-card li.cancel { background:#FEF3C7; padding:3px 5px; border-radius:3px; font-weight:600; }
.month-card li span:last-child { color:#6B7280; font-size:9px; }

/* ========== Print / PDF ========== */
@media print {
  body { background:#fff; }
  .toolbar, .mode-banner, .widget-controls, .drag-handle, .hidden-tray { display:none !important; }
  .pdf-page { box-shadow:none; margin:0; max-width:none; padding:0; }
  body.edit-mode .widget { border:1px solid #E5E7EB; background:#fff; cursor:default; }
